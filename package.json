{
  "name": "@yuehancn/dsh-tool-browser",
  "version": "1.0.0",
  "description": "Browser tools for DeepSeek Harness: open a page, wait for it the way it actually needs, pull out the readable article, and take a screenshot. Uses Playwright when it is installed and falls back to a static fetch that says so, so an unrendered page is never mistaken for an empty one.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "playwright",
    "scraping",
    "readability",
    "extract",
    "screenshot",
    "wait-strategy",
    "mcp",
    "网页抓取"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-browser.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-browser#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-browser/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}